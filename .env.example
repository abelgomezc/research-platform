# Copia este archivo a .env y ajusta los valores.
# .env NO se versiona: nunca subas secretos al repositorio.

# ---------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------
DB_NAME=research_platform
DB_USER=research
# Cambia esta contrasena en cualquier entorno compartido.
DB_PASSWORD=cambia-esta-contrasena
DB_PORT=5432

# ---------------------------------------------------------------------
# Puertos
# ---------------------------------------------------------------------
BACKEND_PORT=8080
FRONTEND_PORT=5173
SEARXNG_PORT=8081
OLLAMA_PORT=11434

# ---------------------------------------------------------------------
# Proveedor de modelos
# OLLAMA_BASE_URL_INTERNAL apunta al servicio de Ollama del compose.
# Para usar el Ollama del host en Docker Desktop (Windows/Mac):
#   OLLAMA_BASE_URL_INTERNAL=http://host.docker.internal:11434
# Para Linux, agrega a docker-compose.yml: extra_hosts: ["host.docker.internal:host-gateway"]
# ---------------------------------------------------------------------
OLLAMA_BASE_URL_INTERNAL=http://ollama:11434

# never  = no descarga modelos (usa los que ya estan en el volumen)
# when_missing = descarga lo que falte
# always = fuerza la descarga
OLLAMA_PULL_STRATEGY=never

# Modelos por rol de agente. qwen3:8b soporta tool calling en Ollama.
LLM_MODEL_PLANNER=qwen3:8b
LLM_MODEL_RESEARCHER=qwen3:8b
LLM_MODEL_VERIFIER=qwen3:8b
LLM_MODEL_SYNTHESIZER=qwen3:8b
LLM_MODEL_REVIEWER=qwen3:8b
LLM_EMBEDDING_MODEL=nomic-embed-text

# ---------------------------------------------------------------------
# Seguridad
# Vacio = API abierto (solo desarrollo). En produccion define un token.
API_TOKEN=

# ---------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173
