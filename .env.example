# Copia este archivo a .env y ajusta los valores.
# .env NO se versiona: nunca subas secretos al repositorio.
#
# NOTA SOBRE PUERTOS: LocalRAG usa 8080 (backend), 5173 (frontend) y 5432
# (PostgreSQL). Este proyecto usa puertos distintos para poder convivir con el.

# ---------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------
DB_NAME=research_platform
DB_USER=research
# IMPORTANTE: esta contrasena debe coincidir con spring.datasource.password de
# application.properties. Docker Compose crea el Postgres con este valor, pero
# el backend solo lo lee de la variable de entorno DB_PASSWORD. Si difieren, el
# backend arranca y falla al conectar. Si cambias el valor aqui, exporta tambien
# DB_PASSWORD antes de arrancarlo.
# Para un entorno compartido cambia las dos a la vez.
DB_PASSWORD=research
DB_PORT=5433

# ---------------------------------------------------------------------
# Usuario de solo lectura para la tool query_database.
# Lo crea la migracion V2__dataset_demo.sql y solo tiene GRANT SELECT:
# aunque el validador de SQL fallara, la base de datos no permitiria escribir.
# ---------------------------------------------------------------------
DB_RO_USER=research_ro
DB_RO_PASSWORD=solo_lectura_demo

# ---------------------------------------------------------------------
# Puertos
# ---------------------------------------------------------------------
BACKEND_PORT=8081
FRONTEND_PORT=5174
SEARXNG_PORT=8090
OLLAMA_PORT=11434

# ---------------------------------------------------------------------
# Proveedor de modelos
# Los scripts de arranque NO activan el perfil with-ollama: se usa el Ollama
# del host, que es donde se descargan los modelos. El backend corre en Docker,
# asi que necesita alcanzar el Ollama del host por esta URL.
#   Windows/macOS: http://host.docker.internal:11434
#   Linux:        http://host.docker.internal:11434 y anade en docker-compose.yml
#                 extra_hosts: ["host.docker.internal:host-gateway"]
# Si prefieres el Ollama del compose, cambia el valor a http://ollama:11434 y
# levanta con: docker compose --profile with-ollama up -d
# ---------------------------------------------------------------------
OLLAMA_BASE_URL_INTERNAL=http://host.docker.internal:11434

# never  = no descarga modelos (usa los que ya estan en el volumen)
# when_missing = descarga lo que falte
# always = fuerza la descarga
OLLAMA_PULL_STRATEGY=never

# Modelos por rol de agente. El protocolo de tool calling de este proyecto es
# JSON en el texto, no tool calling nativo del proveedor: no hace falta que el
# modelo lo soporte. Ver AGENTS.md, seccion agents/.
LLM_MODEL_PLANNER=qwen3:8b
LLM_MODEL_RESEARCHER=qwen3:8b
LLM_MODEL_VERIFIER=qwen3:8b
LLM_MODEL_SYNTHESIZER=qwen3:8b
LLM_MODEL_REVIEWER=qwen3:8b
LLM_EMBEDDING_MODEL=nomic-embed-text

# ---------------------------------------------------------------------
# Conocimiento interno
# pgvector = busqueda semantica simple incluida en este repositorio
# localrag = adaptador HTTP (ver aviso en README: LocalRAG aun no expone
#            el endpoint de busqueda, el adaptador falla de forma controlada)
# ---------------------------------------------------------------------
KNOWLEDGE_PROVIDER=pgvector
EMBEDDING_DIMENSIONS=768
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# URL de LocalRAG cuando corre en el host (Docker Desktop)
LOCALRAG_URL=http://host.docker.internal:8080
LOCALRAG_SEARCH_PATH=/api/search

# ---------------------------------------------------------------------
# Seguridad
# Vacio = API abierto (solo desarrollo). En produccion define un token.
API_TOKEN=

# ---------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5174
